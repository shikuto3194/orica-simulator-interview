{
  "name": "orica-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -b packages/rules-core packages/card-data packages/ai apps/cli && vite build --config apps/playground-web/vite.config.ts",
    "build:api": "node scripts/build-api.mjs",
    "start:api": "node dist/api/server.mjs",
    "test:api-build": "node scripts/check-api-build.mjs",
    "check": "tsc -b packages/rules-core packages/card-data packages/ai apps/cli && tsc -p apps/playground-web/tsconfig.json --noEmit",
    "dev:web": "npx vite --config apps/playground-web/vite.config.ts --port 4173",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "docs:lint": "node scripts/check-docs.mjs",
    "codex:preflight": "node scripts/harness/codex-preflight.mjs",
    "codex:finish-check": "node scripts/harness/codex-finish-check.mjs",
    "codex:finish-check:full": "node scripts/harness/codex-finish-check.mjs --full",
    "check:dev-server": "node scripts/harness/check-dev-server-contract.mjs",
    "usage-limit:clear": "node scripts/clear-usage-limit.mjs",
    "check:ssot": "node scripts/check-ssot.mjs",
    "scan:ssot-candidates": "node scripts/ssot-candidate-scan.mjs",
    "check:wiring": "node scripts/check-wiring.mjs",
    "cards:coverage": "node scripts/cards-coverage.mjs",
    "cards:fidelity": "node scripts/cards-fidelity-audit.mjs",
    "cards:text-ledger": "node scripts/card-text-accountability-audit.mjs",
    "cards:rank": "node scripts/needs-dsl-rank.mjs",
    "cards:test-coverage": "node scripts/check-card-test-coverage.mjs",
    "stub:readiness": "node scripts/stub-readiness.mjs",
    "snapshot": "node scripts/update-snapshot.mjs",
    "fuzz": "node scripts/run-fuzz.mjs",
    "fetch-images": "node scripts/fetch-card-images.mjs",
    "images:prepare": "node scripts/prepare-card-images.mjs",
    "bgm:prepare": "node --experimental-strip-types scripts/prepare-bgm-assets.mjs",
    "fetch-bgm-assets": "node scripts/fetch-bgm-assets.mjs",
    "pack-bgm-assets": "node scripts/pack-bgm-assets.mjs",
    "test:reap": "node scripts/reap-vitest-zombies.mjs",
    "watchdog:processes": "node scripts/watchdog-stale-processes.mjs",
    "watchdog:processes:mcp": "node scripts/watchdog-stale-processes.mjs --include-mcp",
    "watchdog:register": "pwsh scripts/register-watchdog-task.ps1",
    "watchdog:unregister": "pwsh scripts/register-watchdog-task.ps1 -Unregister",
    "autostart:codex": "pwsh scripts/configure-codex-autostart.ps1",
    "supervisor:reconcile": "node scripts/reconcile-supervisor-state.mjs --write --report",
    "supervisor:watch": "pnpm supervisor:reconcile && node scripts/watch-supervisor-events.mjs",
    "supervisor:status": "node scripts/watch-supervisor-events.mjs --once --tail 20",
    "test:supervisor-lock": "node scripts/test-supervisor-lock.mjs",
    "test:supervisor-runner-lock": "node scripts/test-supervisor-runner-lock.mjs",
    "test:telegram-reception": "node scripts/test-telegram-reception.mjs",
    "test:supervisor-handoff": "node scripts/test-supervisor-handoff.mjs",
    "test:effect-debug-loop": "node scripts/test-effect-debug-loop-state.mjs",
    "test:card-text-accountability": "node scripts/test-card-text-accountability-audit.mjs",
    "test:put-action-semantics": "node scripts/test-put-action-semantics-detector.mjs",
    "test:fidelity-audit": "node scripts/test-effect-optionality-detector.mjs && node scripts/test-fidelity-constraint-detector.mjs && node scripts/test-fidelity-flow-detector.mjs && node scripts/test-fidelity-coverage.mjs && node scripts/test-fidelity-review-resolution.mjs && node scripts/test-fidelity-review-state.mjs && node scripts/test-fidelity-audit-integration.mjs && node scripts/test-conditional-cost-scope-audit.mjs && node scripts/audit-conditional-cost.mjs",
    "test:verifier-gate": "node scripts/test-verifier-gate.mjs",
    "verified-commit": "node scripts/verified-commit.mjs",
    "test:harness": "node scripts/test-local-game-gates.mjs && node scripts/test-harness.mjs",
    "test": "node scripts/harness/run-gates.mjs --profile test",
    "test:unit": "node scripts/harness/test-unit.mjs",
    "verify:dialogue": "node scripts/harness/run-gates.mjs --profile dialogue",
    "verify": "node scripts/harness/run-gates.mjs --profile full",
    "verify:push": "node scripts/harness/run-gates.mjs --profile push --reuse",
    "verify:merge": "node scripts/harness/run-gates.mjs --profile merge --reuse",
    "verify:ci": "node scripts/harness/run-gates.mjs --profile ci",
    "verify:scenario": "node scripts/harness/run-gates.mjs --profile scenario",
    "verify:local-game": "node scripts/harness/run-gates.mjs --profile local-game",
    "verify:public-build": "node scripts/harness/run-gates.mjs --profile public-build",
    "ai:chat": "node packages/ai/dist/cli/chat.js",
    "ai:parse-card": "node packages/ai/dist/cli/parse-card.js",
    "ai:rule-qa": "node packages/ai/dist/cli/rule-qa.js",
    "ai:smoke": "node packages/ai/dist/cli/smoke.js",
    "ai:web-smoke": "node packages/ai/dist/cli/web-smoke.js",
    "ai:run": "node packages/ai/dist/cli/run.js",
    "ai:gui": "node packages/ai/dist/cli/gui.js",
    "ai:lint": "node packages/ai/dist/cli/ai-lint.js",
    "ai:skill-report": "node packages/ai/dist/cli/skill-report.js",
    "ai:e2e:attachments": "node packages/ai/dist/cli/e2e-attachments.js",
    "ai:e2e:skill-trigger": "node packages/ai/dist/cli/e2e-skill-trigger.js",
    "trace:smoke": "node scripts/trace-smoke.mjs",
    "trace:validate": "node scripts/trace-validate.mjs",
    "rollout:baseline": "node scripts/rollout-baseline.mjs",
    "policy:bootstrap": "node scripts/policy-bootstrap.mjs",
    "position:bias": "node scripts/position-bias-diagnose.mjs",
    "effect:debug": "node --max-old-space-size=8192 scripts/effect-debug-harvest.mjs",
    "effect:debug:triage": "node scripts/effect-debug-triage.mjs",
    "effect:debug:loop": "node scripts/effect-debug-loop.mjs",
    "metrics:training": "node scripts/training-metrics.mjs",
    "telegram:inbox": "node scripts/telegram-inbox.mjs",
    "telegram:poll": "node scripts/telegram-inbox.mjs poll --max 20",
    "prepare": "husky",
    "storage:status": "node scripts/artifact-storage.mjs status",
    "storage:check": "node scripts/artifact-storage.mjs check",
    "storage:maintain": "node scripts/artifact-storage.mjs maintain",
    "test:storage": "node scripts/test-artifact-storage.mjs && node scripts/test-supervisor-work-plan.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@eslint/js": "^10.0.1",
    "@orica/card-data": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@supabase/supabase-js": "^2.100.1",
    "@types/node": "^22.18.3",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "fast-json-patch": "^3.1.1"
  }
}
