    "vitest",
    "secrets"
  ],
  "sourceGates": [
    "format",
    "lint",
    "dev-contract",
    "types",
    "docs",
    "ssot",
    "wiring",
    "ledger"
  ],
  "requiredScopes": [
    {
      "patterns": [
        "^apps/playground-web/server/(?:game-api|local-game-(?:session|api))\\.ts$",
        "^apps/playground-web/src/(?:App\\.tsx|AuthContext\\.tsx|main\\.tsx|development\\.ts|local-game-auth\\.tsx|hooks/useRoomSync\\.ts|components/BattleScreen\\.tsx)$",
        "^apps/playground-web/shared/room-protocol\\.ts$",
        "^apps/playground-web/vite\\.config\\.ts$",
        "^playwright\\.local\\.config\\.ts$"
      ],
      "gates": ["local-game-ui"],
      "whenFull": true
    },
    {
      "patterns": [
        "^apps/playground-web/src/(?:main\\.tsx|development\\.ts|local-game-auth\\.tsx)$",
        "^apps/playground-web/vite\\.config\\.ts$",
        "^playwright\\.public\\.config\\.ts$"
      ],
      "gates": ["build", "public-build"]
    }
  ]
}
