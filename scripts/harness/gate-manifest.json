    },
    "supervisor-lock": {
      "script": "test:supervisor-lock"
    },
    "supervisor-runner-lock": {
      "script": "test:supervisor-runner-lock"
    },
    "storage": {
      "node": "scripts/test-artifact-storage.mjs"
    },
    "handoff": {
