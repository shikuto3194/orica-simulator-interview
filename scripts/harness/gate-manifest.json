    {
      "patterns": ["^manual/ai-reference/10_rules/.*\\.md$"],
      "gates": ["docs", "fidelity"]
    },
    {
      "patterns": ["^manual/ai-reference/10_rules/04_state-based-rules\\.md$"],
      "gates": ["ssot"]
    },
    {
      "patterns": ["^packages/rules-core/test/helpers/.*\\.ts$"],
      "gates": ["vitest", "fidelity"]
    },
    {
      "patterns": [
        "^apps/playground-web/test/local-game-(?:session|api)\\.test\\.ts$"
      ],
      "gates": ["local-game-unit"]
    },
    {
      "patterns": [
        "^e2e/(?:local-game-(?:sync\\.spec|fixture)|scenario-blazing-star-oracle\\.spec)\\.ts$",
