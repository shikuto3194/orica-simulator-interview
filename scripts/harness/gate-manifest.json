    },
    "lint": {
      "script": "lint"
    },
    "dev-contract": {
      "script": "check:dev-server"
    },
    "types": {
      "script": "check"
    },
    "docs": {
      "node": "scripts/check-docs.mjs",
      "args": ["--summary"]
    },
    "ssot": {
